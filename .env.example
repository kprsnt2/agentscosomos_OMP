# Agent Cosmos — Environment Variables

# Database (Turso). For local dev, use file:./world.db
DATABASE_URL=file:./world.db
DATABASE_AUTH_TOKEN=

# LLM Providers (fallback chain: OpenAI → OpenRouter → Groq → Gemini)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Rate limiting — minimum seconds between calls per provider
RATE_LIMIT_RPM=10

# Auth
CYCLE_SECRET=change-me-to-a-random-string
ADMIN_PASSWORD=change-me

# Vercel Cron (set in vercel.json, this protects the endpoint)
CRON_SECRET=change-me-to-a-random-string
